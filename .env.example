# ==============================================================================
# LandMark Real Estate GIS Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the values according to your environment:
#   Linux/macOS : cp .env.example .env
#   Windows PS  : copy .env.example .env
# ==============================================================================

# --- Database (PostgreSQL 16 + PostGIS 3.4) ---
POSTGRES_DB=landmark_db
POSTGRES_USER=landmark_user
POSTGRES_PASSWORD=landmark_pass
POSTGRES_PORT=5432

# --- Backend API Configuration ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/landmark_db
SPRING_DATASOURCE_USERNAME=landmark_user
SPRING_DATASOURCE_PASSWORD=landmark_pass
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# --- JWT Cryptographic Security (HMAC-SHA256) ---
# Cryptographically secure 256-bit (32-byte) Base64-encoded secret key:
JWT_SECRET_KEY=tM/Lavz+teGCpzrPfvjhVK9djZV6tPAoaJaoaGjJkvU=
# Token lifespan in milliseconds (86400000 ms = 24 hours):
JWT_EXPIRATION_MS=86400000

# --- Frontend Web Application ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
